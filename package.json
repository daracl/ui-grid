{
  "name": "@daracl/grid",
  "version": "0.0.26",
  "description": "Daracl Grid",
  "author": {
    "name": "daracl",
    "email": "darainfosys@gmail.com",
    "url": "https://ui.daracl.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/ui-grid.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/grid",
    "daraclGrid",
    "daracl-grid",
    "grid",
    "validation",
    "daracl",
    "javascript"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/daracl/ui-grid",
  "bugs": {
    "url": "https://github.com/daracl/ui-grid/issues",
    "email": "darainfosys@gmail.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.grid.umd.js"
    },
    "./dist/*": "./dist/*",
    "./style/*": "./style/*"
  },
  "files": [
    "dist",
    "style"
  ],
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "devDependencies": {
    "@daracl/datetimepicker": "^0.0.13",
    "@playwright/test": "^1.55.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.1.0",
    "@types/pdfkit": "^0.17.6",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "eslint": "^8.40.0",
    "eslint-config-prettier": "^8.8.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^2.8.8",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.107.0",
    "terser": "^5.47.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.9.5",
    "typedoc": "^0.28.20",
    "typescript": "5.6.3",
    "vite": "~7.3.7"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:umd": "vite build --config vite.config.umd.mjs --mode production && vite build --config vite.config.umd.mjs --mode development",
    "build:escjs": "vite build --config vite.config.mjs --mode production && vite build --config vite.config.mjs --mode development",
    "mergenclean": "npm run copy-dts && npm run build:tsc && npm run copy-unmin && npm run clean:unmin && npm run copy-html",
    "build:tsc": "tsc -p tsconfig-build.json --emitDeclarationOnly && tsc-alias -p tsconfig-build.json",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "npm run build:tsc",
    "test": "jest",
    "pwtest": "playwright test",
    "clean:unmin": "node scripts/build-files.mjs clean-unmin",
    "copy-html": "node scripts/build-files.mjs html",
    "copy-unmin": "node scripts/build-files.mjs unmin",
    "copy-dts": "node scripts/build-files.mjs dts",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "core:link": "node scripts/link-core.cjs",
    "test:core-link": "node --test scripts/link-core.test.cjs",
    "build:verify": "node scripts/build.mjs --verify",
    "test:scripts": "node --test scripts/*.test.cjs scripts/*.test.mjs",
    "audit:security": "npm audit --omit=dev",
    "audit:security:all": "npm audit"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "overrides": {
    "@daracl/datetimepicker": {
      "@daracl/core": "$@daracl/core"
    }
  },
  "dependencies": {
    "@daracl/core": "0.0.12",
    "@daracl/ui-style": "0.0.7",
    "pdfkit": "^0.20.2"
  }
}
