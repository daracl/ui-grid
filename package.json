{
  "name": "@daracl/grid",
  "version": "0.0.8",
  "sideEffects": false,
  "description": "Daracl Grid",
  "author": {
    "name": "daracl",
    "email": "darainfosys@gmail.com",
    "url": "https://ui.daracl.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daracl/ui-grid.git"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "license": "MIT",
  "keywords": [
    "@daracl/grid",
    "daraclGrid",
    "daracl-grid",
    "grid",
    "validation",
    "daracl",
    "javascript"
  ],
  "main": "src/index.ts",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/daracl/ui-grid",
  "bugs": {
    "url": "https://github.com/daracl/ui-grid/issues",
    "email": "darainfosys@gmail.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./umd": {
      "import": "./dist/daracl.grid.umd.js"
    },
    "./dist/": "./dist/",
    "./style/": "./style/"
  },
  "files": [
    "dist",
    "style"
  ],
  "dependencies": {
    "@babel/plugin-syntax-dynamic-import": "^7.8.3",
    "init": "^0.1.2",
    "ink-docstrap": "^1.3.2",
    "tslint": "^6.1.3",
    "tslint-config-prettier": "^1.18.0"
  },
  "editor.formatOnSave": true,
  "[javascript]": {
    "editor.formatOnSave": false
  },
  "devDependencies": {
    "@daracl/core": "^0.0.5",
    "@daracl/datetimepicker": "^0.0.13",
    "@mxssfd/typedoc-theme": "^1.1.1",
    "@playwright/test": "^1.55.1",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.1.0",
    "@typescript-eslint/eslint-plugin": "^5.59.5",
    "@typescript-eslint/parser": "^5.59.5",
    "cpx": "^1.5.0",
    "eslint": "^8.40.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^8.8.0",
    "eslint-plugin-import": "^2.27.5",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.32.2",
    "file-loader": "^6.2.0",
    "jest": "^29.0.0",
    "jest-environment-jsdom": "^29.7.0",
    "material-icons": "^1.13.8",
    "mini-css-extract-plugin": "^2.7.6",
    "prettier": "^2.8.8",
    "rimraf": "^6.0.1",
    "rollup-plugin-visualizer": "^6.0.3",
    "sass": "^1.80.2",
    "sass-loader": "^16.0.2",
    "style-loader": "^3.3.3",
    "terser": "^5.47.0",
    "ts-jest": "^29.4.6",
    "tsc-alias": "^1.9.5",
    "typedoc": "^0.26.7",
    "typescript": "^5.1.6",
    "url-loader": "^4.1.1",
    "vite": "^5.4.0",
    "vite-plugin-banner": "^0.7.1"
  },
  "scripts": {
    "build": "npm run build:escjs && npm run build:umd && npm run mergenclean",
    "build:umd": "vite build --config vite.config.umd.js --mode production && vite build --config vite.config.umd.js --mode development",
    "build:escjs": "vite build --config vite.config.js --mode production && vite build --config vite.config.js --mode development",
    "mergenclean": "npm run copy-dts && npm run build:tsc && npm run copy-unmin && npm run clean:unmin && npm run copy-html",
    "build:tsc": "tsc --emitDeclarationOnly && tsc-alias -p tsconfig.json",
    "dev": "vite",
    "preview": "vite preview",
    "docs:gen": "typedoc --tsconfig tsconfig.doc.json",
    "dts:gen": "npx -p typescript tsc src/index.js --declaration --allowJs --emitDeclarationOnly --outDir dist",
    "test": "jest",
    "pwtest": "playwright test",
    "clean:unmin": "rimraf dist/unmin",
    "copy-html": "cpx \"public/index.html\" dist",
    "copy-unmin": "cpx \"dist/unmin/**.*\" dist",
    "copy-dts": "cpx \"src/**/*.d.ts\" dist",
    "prepublishOnly": "npm run build"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
}
